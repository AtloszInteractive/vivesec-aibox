# ViVeSec AI Box — local compose env. Copy to `.env` and fill in.
# NEVER commit the real .env. The internal token is a network-internal shared
# secret between the HÍD and the rag-engine (spec §3).

# Shared internal service token (HÍD -> rag-engine bearer). Generate a strong one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_INTERNAL_TOKEN=change-me

# Swappable engine + storage backend (spec §9, §11.1)
RAG_ENGINE_NAME=baseline        # baseline | colearn
RAG_VECTOR_BACKEND=sqlite       # sqlite | postgres
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_BACKEND=ollama        # auto | ollama | hashing (hashing = dev/CI, no model)
RAG_RERANK=true

# Generation LLM. Appliance default = on-device Ollama (nothing leaves the box).
RAG_GEN_PROVIDER=ollama         # ollama | openai | gemini
RAG_GEN_MODEL=qwen2.5:14b

# --- AI Box adapter (the UI's only backend) ------------------------------- #
# The UI talks to the adapter for every answer, the drive listing and saving.
# On the box itself this stays loopback; from a dev machine point it at the box
# (LAN or tailnet address).
ADAPTER_URL=http://127.0.0.1:8088
ADAPTER_DEMO_DRIVE=/storage/drives/finance/
ADAPTER_DEMO_USER=demo
# Demo/test only: shows the drive switcher in the drive panel. Leave unset in
# production — there the drive comes from the ViVeSecBox session.
# ADAPTER_DEMO_DRIVE_PICKER=1

# --- DEV/TEST ONLY: cloud generation -------------------------------------- #
# The local LLM is slow on dev machines, so openai/gemini can stand in for fast
# end-to-end testing. THIS SENDS DOCUMENT CONTEXT TO AN EXTERNAL API — only ever
# use it with the SYNTHETIC DEMO CORPUS, never real documents, NEVER on the box.
# Hard-gated: cloud is ignored unless RAG_ALLOW_CLOUD_LLM=true.
# NEVER put a real API key in THIS file — it is a committed template. Put real
# secrets only in `.env` (gitignored).
RAG_ALLOW_CLOUD_LLM=false
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# With a cloud provider, set RAG_GEN_MODEL to that provider's model, e.g.:
#   RAG_GEN_PROVIDER=openai  RAG_GEN_MODEL=gpt-4o-mini
#   RAG_GEN_PROVIDER=gemini  RAG_GEN_MODEL=gemini-2.0-flash

# Postgres backend (only needed with `--profile postgres`)
POSTGRES_USER=vivesec
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
# RAG_POSTGRES_DSN=postgresql://vivesec:change-me@postgres:5432/rag
