       {"type": "USES", "from": "contact", "to": "phone"},
       {"type": "USES", "from": "contact", "to": "email"},
       {"type": "RESIDES_AT", "from": "contact", "to": "address"}
     ],
     "acl": {"column": "Intézet kód", "pattern": "group:bv-intezet-{value}", "always": ["group:bv-orszagos"]}}
  ]
