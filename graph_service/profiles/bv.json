     ],
     "relations": [
       {"type": "PLACED_IN", "from": "inmate", "to": "cell", "start": "Elhelyezés kezdete", "end": "Elhelyezés vége", "label": ["Behelyezés indoka", "Kihelyezés indoka"], "label_codelist": "indok"}
     ],
     "acl": {"column": "Intézet kód", "pattern": "group:bv-intezet-{value}", "always": ["group:bv-orszagos"]}},
    {"id": "contacts", "label": {"en": "Approved contacts", "hu": "Kapcsolattartói lista", "da": "Godkendte kontaktpersoner", "de": "Zugelassene Kontaktpersonen"}, "title": "Kapcsolattartói lista",
     "record_id": "Rekordazonosító", "mode": "delta", "deleted": {"column": "Törölve", "values": ["igen", "i", "1", "true", "x"]},
     "codelists": {"kapcsolat": {"ANYA": "anyja", "APA": "apja", "TESTV": "testvére", "HAZT": "házastársa", "ELT": "élettársa", "GYERM": "gyermeke", "ROKON": "egyéb rokon", "ISM": "ismerős", "VED": "védő"}},
     "entities": [
       {"ref": "inmate", "type": "person", "subtype": "inmate", "name": "Fogvatartott neve", "attributes": {"registry_number": "Fogvatartott nyilvántartási száma"}},
       {"ref": "contact", "type": "person", "subtype": "contact", "name": "Kapcsolattartó neve", "person_key": true, "key_only": true,
        "attributes": {"birth_place": "Születési hely", "birth_date": "Születési idő", "mother_name": "Anyja neve"}},
       {"ref": "phone", "type": "identifier", "subtype": "phone", "name": "Telefonszám"},
